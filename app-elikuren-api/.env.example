APP_NAME=elikuren-api
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Neon pooled URL for the running app (or local Postgres)
DATABASE_URL=postgresql+psycopg://elikuren:elikuren@localhost:5432/elikuren

# Neon direct URL for Alembic (optional; falls back to DATABASE_URL)
DATABASE_URL_MIGRATIONS=postgresql+psycopg://elikuren:elikuren@localhost:5432/elikuren

CLERK_ISSUER=https://your-clerk-issuer.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_xxx

# Paste the full Clerk JWT public key PEM (use \n for newlines in one-line envs)
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# Optional: comma-separated authorized parties (azp)
CLERK_AUTHORIZED_PARTIES=

CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
