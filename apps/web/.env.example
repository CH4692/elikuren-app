# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (Frankfurt)
# Runtime / Prisma client: prefer pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Migrations (prisma migrate): prefer direct / non-pooler URL
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Clerk (Development keys locally; Production keys on Vercel Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Optional Clerk frontend API proxy
# NEXT_PUBLIC_CLERK_PROXY_URL=

# Feature flags ("true" / "false")
NEXT_PUBLIC_FLAG_AUTH_DISABLED=true
NEXT_PUBLIC_FLAG_ABOUT_DISABLED=true
NEXT_PUBLIC_FLAG_HISTORY_DISABLED=true
NEXT_PUBLIC_FLAG_ELIKUREN_DISABLED=false
NEXT_PUBLIC_FLAG_EIGHT_TO_THE_BAR_DISABLED=true
NEXT_PUBLIC_FLAG_MUSICAL_TEAM_DISABLED=true

# Contact form (server-only)
RESEND_API_KEY=re_xxx
