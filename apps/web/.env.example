# -----------------------------------------------------------------------------
# Template — copy to .env.local for local development:
#   cp .env.example .env.local
#
# Env files in this app:
#   .env.example  template (committed)
#   .env.local    your secrets (gitignored, used by Next.js + Prisma locally)
#   .env.test     safe placeholders for CI / Playwright (committed)
# -----------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Neon: pooled + direct; locally both can be the same URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js — generate secret with: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

# Resend (contact form + magic links)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@kammerchor-elikuren.de
