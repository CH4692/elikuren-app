# Deploy-Umgebung – Kopie als .env.prod und .env.dev anlegen und anpassen.
# Prod: docker compose -f docker-compose.prod.yml --env-file .env.prod ...
# Dev:  docker compose -f docker-compose.dev.yml --env-file .env.dev ...

# ---- Traefik / Hosts ----
TRAEFIK_DASHBOARD_HOST=traefik.kammerchor-elikuren.de
WEB_HOST=kammerchor-elikuren.de
API_HOST=api.kammerchor-elikuren.de

# ---- LetsEncrypt (in traefik.yml E-Mail anpassen!) ----
# Nur Referenz – E-Mail steht in deploy/traefik.yml

# ---- Web-App (Build + Laufzeit) ----
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.kammerchor-elikuren.de
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile

# ---- API (Laufzeit, bei Bedarf) ----
# DATABASE_URL=
# JWT_SECRET=
