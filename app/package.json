{
  "name": "elikuren-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:unit:coverage": "c8 --reporter=text --reporter=lcov --reports-dir=coverage --include=lib/**/*.ts --exclude=lib/generated/** npm run test:unit",
    "test:integration": "playwright test tests/integration",
    "test:ui": "playwright test tests/pages tests/smoke",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test tests/integration tests/pages tests/smoke",
    "test:security": "playwright test tests/smoke/security-headers.test.ts tests/smoke/security-authz.test.ts",
    "test:perf": "playwright test tests/smoke/performance.test.ts",
    "test:a11y": "playwright test tests/smoke/a11y.test.ts",
    "test:audit": "node ./scripts/ci-npm-audit.mjs",
    "test:mutation": "stryker run",
    "test:setup": "npx playwright install chromium",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:wipe-e2e": "npx tsx ./scripts/wipe-e2e-data.ts --confirm",
    "db:wipe-preview": "npx tsx ./scripts/wipe-preview.ts --confirm",
    "db:seed-preview": "npx tsx ./scripts/seed-preview.ts --confirm",
    "db:seed-preview-media": "npx tsx ./scripts/seed-preview-sample-media.ts --confirm",
    "db:seed-production": "npx tsx ./scripts/seed-production.ts --confirm",
    "import:media": "npx tsx scripts/import-media.ts",
    "import:media:apply": "npx tsx scripts/import-media.ts --apply",
    "migrate:cms-static-media": "npx tsx scripts/migrate-cms-static-media.ts",
    "migrate:cms-static-media:apply": "npx tsx scripts/migrate-cms-static-media.ts --apply",
    "import:members": "npx tsx scripts/import-members-xlsx.ts",
    "import:folder-batches": "npx tsx scripts/import-folder-batches.ts",
    "import:folder-batches:apply": "npx tsx scripts/import-folder-batches.ts --apply",
    "concerts:merge-winterreise": "npx tsx ./scripts/merge-winterreise-performances.ts",
    "concerts:merge-winterreise:apply": "npx tsx ./scripts/merge-winterreise-performances.ts --apply",
    "email:dev": "email dev --dir emails"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/render": "2.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.1",
    "react-icons": "^5.7.0",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@react-email/ui": "^6.9.2",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
