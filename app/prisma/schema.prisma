generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  vorstand
  mitglied
  kassenwart
  kassenpruefer
}

enum MembershipRequestStatus {
  pending
  approved
  rejected
}

enum AccessAuditAction {
  request_created
  approved
  rejected
  disabled
  enabled
  magic_link_denied
  magic_link_sent
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  firstname     String?
  lastname      String?
  street        String?
  houseNumber   String?   @map("house_number")
  postalCode    String?   @map("postal_code")
  location      String?
  phone         String?
  birthday      DateTime? @db.Date
  voice         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSignedIn  DateTime? @map("last_signed_in")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  memberSince   DateTime? @map("member_since") @db.Date
  role          Role      @default(mitglied)
  passwordHash  String?   @map("password_hash")
  accounts      Account[]
  sessions      Session[]
  approvedRequests MembershipRequest[] @relation("ApprovedBy")
  rejectedRequests MembershipRequest[] @relation("RejectedBy")

  @@index([firstname])
  @@index([lastname])
  @@map("users")
}

model MembershipRequest {
  id           String                  @id @default(cuid())
  email        String
  firstname    String?
  lastname     String?
  message      String?                 @db.Text
  voice        String?
  adminNote    String?                 @map("admin_note") @db.Text
  status       MembershipRequestStatus @default(pending)
  createdAt    DateTime                @default(now()) @map("created_at")
  approvedAt   DateTime?               @map("approved_at")
  approvedById String?                 @map("approved_by_id")
  approvedBy   User?                   @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt   DateTime?               @map("rejected_at")
  rejectedById String?                 @map("rejected_by_id")
  rejectedBy   User?                   @relation("RejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@map("membership_requests")
}

model AccessAuditLog {
  id          String            @id @default(cuid())
  action      AccessAuditAction
  actorUserId String?           @map("actor_user_id")
  targetEmail String            @map("target_email")
  requestId   String?           @map("request_id")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([targetEmail])
  @@index([action])
  @@index([createdAt])
  @@map("access_audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
