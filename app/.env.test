# -----------------------------------------------------------------------------
# Non-secret defaults for Playwright / CI (committed).
# Local Neon credentials go in .env.local (overrides these).
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
AUTH_SECRET=test-auth-secret-not-for-production-use
AUTH_URL=http://127.0.0.1:3000
RESEND_API_KEY=re_test_placeholder
EMAIL_FROM=noreply@kammerchor-elikuren.de

# Placeholders so prisma generate / next build work without a live DB.
# Full E2E against Neon uses .env.local instead.
DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build?sslmode=disable
DATABASE_URL_UNPOOLED=postgresql://build:build@127.0.0.1:5432/build?sslmode=disable

# Playwright admin (upserted in tests/global-setup.ts when a real DB is available)
E2E_ADMIN_EMAIL=e2e-admin@kammerchor-elikuren.test
E2E_ADMIN_PASSWORD=E2E-Admin-Test-Password!
