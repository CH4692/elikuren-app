# -----------------------------------------------------------------------------
# Template — copy to .env.local for local development:
#   cp .env.example .env.local
#
# Env files in this app:
#   .env.example  template (committed)
#   .env.local    your secrets (gitignored, used by Next.js + Prisma locally)
#   .env.test     non-secret Playwright/CI defaults (committed)
# -----------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Neon: pooled + direct; locally both can be the same URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js — generate secret with: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
# Optional: show password login on /auth/sign-in (local/E2E only — do not set on Vercel)
# AUTH_ENABLE_PASSWORD_LOGIN=1


# Resend (contact form + magic links)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@kammerchor-elikuren.de

# Optional seed overrides: npm run db:seed
# SEED_ADMIN_EMAIL=admin@kammerchor-elikuren.de
# SEED_ADMIN_PASSWORD=change-me

# Playwright Freigabe-Tests (defaults also in .env.test; global-setup upserts this user)
# E2E_ADMIN_EMAIL=e2e-admin@kammerchor-elikuren.test
# E2E_ADMIN_PASSWORD=E2E-Admin-Test-Password!

# Cloudflare R2 (server-only — never NEXT_PUBLIC_)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_SIGNED_URL_TTL_SECONDS=300
