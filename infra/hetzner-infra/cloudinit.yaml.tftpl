#cloud-config
package_update: true
package_upgrade: true

bootcmd:
  - mkdir -p /opt/elikuren-app/deploy
  - mkdir -p /root/.docker
  - mkdir -p /home/deploy/.docker

users:
  - name: deploy
    groups: [sudo, docker]
    shell: /bin/bash
    ssh_authorized_keys:
      - ${deploy_public_key}
    sudo: ALL=(ALL) NOPASSWD:ALL

ssh_pwauth: false

write_files:
  - path: /root/.docker/config.json
    permissions: "0600"
    owner: root:root
    content: |
      {
        "auths": {
          "ghcr.io": {
            "auth": "${ghcr_auth}"
          }
        }
      }

  - path: /home/deploy/.docker/config.json
    permissions: "0600"
    owner: root:root
    content: |
      {
        "auths": {
          "ghcr.io": {
            "auth": "${ghcr_auth}"
          }
        }
      }

  - path: /tmp/.env.dev
    permissions: "0600"
    content: |
      WEB_IMAGE=ghcr.io/ch4692/elikuren-web:dev-latest
      API_IMAGE=ghcr.io/ch4692/elikuren-api:dev-latest
      NODE_ENV=production
      WEB_HOST=${dev_web_host}
      API_HOST=${dev_api_host}
      TRAEFIK_DASHBOARD_HOST=${traefik_dashboard_host}
      NEXT_PUBLIC_API_URL=https://${dev_api_host}
      NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${clerk_publishable_key_dev}
      CLERK_SECRET_KEY=${clerk_secret_key_dev}

  - path: /tmp/.env.prod
    permissions: "0600"
    content: |
      WEB_IMAGE=ghcr.io/ch4692/elikuren-web:prod-latest
      API_IMAGE=ghcr.io/ch4692/elikuren-api:prod-latest
      NODE_ENV=production
      WEB_HOST=${prod_web_host}
      API_HOST=${prod_api_host}
      TRAEFIK_DASHBOARD_HOST=${traefik_dashboard_host}
      NEXT_PUBLIC_API_URL=https://${prod_api_host}
      NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${clerk_publishable_key_prod}
      CLERK_SECRET_KEY=${clerk_secret_key_prod}

runcmd:
  - hostnamectl set-hostname ${hostname}
  - systemctl stop nginx || true
  - systemctl disable nginx || true

  # Install Docker
  - curl -fsSL https://get.docker.com | sh
  - apt-get install -y docker-compose-plugin git
  - systemctl enable docker
  - systemctl start docker
  - usermod -aG docker deploy

  # Docker network
  - docker network create proxy || true
  - chown -R deploy:deploy /home/deploy/.docker

  # Install Tailscale
  - curl -fsSL https://tailscale.com/install.sh | sh
  - systemctl enable tailscaled
  - systemctl start tailscaled
  - bash -c 'until systemctl is-active --quiet tailscaled; do sleep 1; done'
  - tailscale up --authkey=${tailscale_authkey} --ssh --advertise-tags=tag:server --hostname=${hostname} --accept-dns=false --accept-routes=false

  # Clone repository
  - rm -rf /opt/elikuren-app
  - git clone https://github.com/${github_owner}/elikuren-app /opt/elikuren-app
  - chown -R deploy:deploy /home/deploy/.docker
  - chmod +x /opt/elikuren-app/deploy/update.sh
  - git config --system --add safe.directory /opt/elikuren-app
  - cp /tmp/.env.dev /opt/elikuren-app/deploy/.env.dev
  - cp /tmp/.env.prod /opt/elikuren-app/deploy/.env.prod
  - chown deploy:deploy /opt/elikuren-app/deploy/.env.dev /opt/elikuren-app/deploy/.env.prod
  - chmod 600 /opt/elikuren-app/deploy/.env.dev /opt/elikuren-app/deploy/.env.prod
  - chown -R deploy:deploy /opt/elikuren-app

  # Install systemd updater
  - cp /opt/elikuren-app/deploy/systemd/elikuren-update@.service /etc/systemd/system/
  - cp /opt/elikuren-app/deploy/systemd/elikuren-update@.timer /etc/systemd/system/
  - systemctl daemon-reload
  - systemctl enable --now elikuren-update@${stack}.timer

  # Traefik ACME storage
  - mkdir -p /opt/elikuren-app/deploy/traefik/letsencrypt
  - touch /opt/elikuren-app/deploy/traefik/letsencrypt/acme.json
  - chmod 600 /opt/elikuren-app/deploy/traefik/letsencrypt/acme.json

  # Start Traefik
  - cd /opt/elikuren-app/deploy/traefik && docker compose --env-file .env.${stack} up -d

  # Initial deploy
  - /opt/elikuren-app/deploy/update.sh ${stack}

final_message: "cloud-init finished for ${hostname}"
